<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="lb">
  <head>
    <title><%= Lucid::Backoffice.configuration.title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <%= csrf_meta_tags %>
    <%= render "lucid/backoffice/shared/head" %>
  </head>
  <body class="lb-body">
    <%= render "lucid/backoffice/shared/topbar" %>
    <main class="lb-main">
      <% if notice %><p class="lb-flash lb-flash-ok"><%= notice %></p><% end %>
      <% if alert %><p class="lb-flash lb-flash-error"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
