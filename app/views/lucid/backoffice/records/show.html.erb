<h1><%= params[:table] %> #<%= params[:id] %></h1>
<dl class="lb-detail">
  <% @cells.each do |cell| %>
    <dt><%= cell.column.name %> <% unless cell.column.category == "public" %><small><%= cell.column.category %></small><% end %></dt>
    <dd><%= render "lucid/backoffice/ui/value", cell: cell %></dd>
  <% end %>
</dl>
<% record_model = params[:table].to_s.classify.safe_constantize %>
<% if record_model && record_model < ActiveRecord::Base %>
  <%= render "lucid/backoffice/ui/actions", target: params[:table], record: tenancy.with(current_tenant) { record_model.find_by(id: params[:id]) }, tenant: current_tenant %>
<% end %>
