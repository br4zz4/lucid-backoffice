<%= render "lucid/backoffice/ui/page_header",
      title: params[:table], subtitle: t("lucid_backoffice.records_count", count: @page.total),
      crumbs: lb_context_crumbs + [[t("lucid_backoffice.data"), (current_tenant ? tenant_data_path(tenant_id: tenancy.identifier(current_tenant)) : data_path)], [params[:table], nil]] %>
<% if @page.ignored_filters.any? %><p class="lb-flash lb-flash-warn"><%= t("lucid_backoffice.ignored_filters", filters: @page.ignored_filters.join(", ")) %></p><% end %>
<% if @page.total.zero? %>
  <%= render "lucid/backoffice/ui/empty", message: t("lucid_backoffice.no_records", table: params[:table]) %>
<% else %>
  <%= render "lucid/backoffice/ui/table", columns: @page.columns, rows: @page.rows,
        link_to_row: ->(cell, cells) {
          id = cells.find { |c| c.column.name == "id" }&.value
          if cell.column.name == "id"
            link_to cell.value, (current_tenant ? tenant_record_path(tenant_id: tenancy.identifier(current_tenant), table: params[:table], id: id) : record_path(table: params[:table], id: id))
          else
            render("lucid/backoffice/ui/value", cell: cell)
          end
        } %>
  <%= render "lucid/backoffice/ui/pager", page: @page.page, pages: @page.pages, total: @page.total %>
<% end %>
