<%= render "lucid/backoffice/ui/page_header", title: t("lucid_backoffice.data"),
      crumbs: lb_context_crumbs + [[t("lucid_backoffice.data"), nil]] %>
<ul class="lb-list">
  <% @tables.each do |table| %>
    <li><a href="<%= current_tenant ? tenant_table_path(tenant_id: tenancy.identifier(current_tenant), table: table) : table_path(table: table) %>"><%= table %></a></li>
  <% end %>
</ul>
