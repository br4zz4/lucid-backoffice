<h1><%= @action_class.label %></h1>
<p class="lb-flash"><%= @notice %></p>
<section class="lb-section lb-secret">
  <h2><%= t("lucid_backoffice.secret_title") %></h2>
  <input type="text" readonly value="<%= @secret %>" id="lb-secret-value" class="lb-secret-value" autocomplete="off" aria-label="<%= t("lucid_backoffice.secret_title") %>">
  <button type="button" class="lb-button" data-lb-copy="lb-secret-value" data-lb-copied="<%= t("lucid_backoffice.copied") %>"><%= t("lucid_backoffice.copy") %></button>
  <p class="lb-flash lb-flash-warn"><%= t("lucid_backoffice.secret_warning") %></p>
  <a class="lb-button" href="<%= @continue %>"><%= t("lucid_backoffice.continue") %></a>
</section>
