<section class="lb-section">
  <h2><%= t("lucid_backoffice.preview") %></h2>
  <% changes.each do |change| %>
    <p><strong><%= change.label %></strong>: <span class="lb-value lb-masked"><%= change.before %></span> → <span class="lb-value lb-masked"><%= change.after %></span></p>
  <% end %>
  <% listings.each do |listing| %>
    <h3><%= listing.title %></h3>
    <ul><% listing.items.each do |item| %><li><%= item %></li><% end %></ul>
  <% end %>
</section>
