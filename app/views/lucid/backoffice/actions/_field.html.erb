<% value = action.values.fetch(field.name) { initial[field.name] } %>
<div class="lb-field">
  <label for="fields_<%= field.name %>"><%= field.name.to_s.humanize %></label>
  <% if value.equal?(Lucid::Backoffice::Action::Field::LOCKED) || local_assigns.fetch(:locked, []).include?(field.name) %>
    <%= text_field_tag nil, t("lucid_backoffice.locked_value"), id: "fields_#{field.name}", disabled: true, class: "lb-locked" %>
    <small class="lb-locked-note"><%= t("lucid_backoffice.locked_field") %></small>
  <% elsif field.partial %>
    <%= render field.partial, field: field, value: value, action: action %>
  <% else %>
    <% case field.type %>
    <% when :select %>
      <% options = Array(field.choices.respond_to?(:call) ? action.instance_exec(&field.choices) : field.choices) %>
      <%= select_tag "fields[#{field.name}]", options_for_select(options, value), id: "fields_#{field.name}", include_blank: !field.required %>
    <% when :boolean %>
      <%= check_box_tag "fields[#{field.name}]", "1", value, id: "fields_#{field.name}" %>
    <% when :text %>
      <%= text_area_tag "fields[#{field.name}]", value, id: "fields_#{field.name}" %>
    <% when :integer, :record %>
      <%= number_field_tag "fields[#{field.name}]", value, id: "fields_#{field.name}", step: 1 %>
    <% when :date %>
      <%= date_field_tag "fields[#{field.name}]", value, id: "fields_#{field.name}" %>
    <% else %>
      <%= text_field_tag "fields[#{field.name}]", value, id: "fields_#{field.name}" %>
    <% end %>
  <% end %>
</div>
