<% value = action.values.fetch(field.name) { initial[field.name] } %>
<div class="lb-field">
  <label for="fields_<%= field.name %>"><%= field.name.to_s.humanize %></label>
  <% if value.equal?(Lucid::Backoffice::Action::Field::LOCKED) || local_assigns.fetch(:locked, []).include?(field.name) %>
    <% mode = action.unlock_mode(field.name) %>
    <% can_unlock = mode == :write || (mode == :read && allowed?(:reveal, { tenant: current_tenant, category: action.unlock_category(field.name) })) %>
    <% unlock_url = mode == :read && can_unlock ? lb_routes.unlock_action_field_path(action_key: action.class.key, field: field.name, record_id: params[:record_id], tenant_id: params[:tenant_id]) : nil %>
    <div class="lb-locked-field"<%= raw " data-lb-unlock=\"#{mode}\"" if can_unlock %><%= raw " data-lb-unlock-url=\"#{ERB::Util.html_escape(unlock_url)}\"" if unlock_url %> data-lb-field="<%= field.name %>">
      <%= text_field_tag nil, t("lucid_backoffice.locked_value"), id: "fields_#{field.name}", disabled: true, class: "lb-locked" %>
      <% if can_unlock %>
        <template data-lb-control><%= render "lucid/backoffice/actions/control", field: field, value: nil, action: action %></template>
        <button type="button" class="lb-button lb-button-quiet lb-unlock" data-lb-unlock-button data-lb-failed="<%= t("lucid_backoffice.unlock_failed") %>" data-lb-hide="<%= t("lucid_backoffice.hide_value") %>" data-lb-show="<%= t("lucid_backoffice.show_value") %>">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          <span data-lb-label><%= mode == :write ? t("lucid_backoffice.set_new_value") : t("lucid_backoffice.unlock_field") %></span>
        </button>
      <% end %>
    </div>
    <small class="lb-locked-note"><%= t("lucid_backoffice.locked_field") %></small>
  <% else %>
    <%= render "lucid/backoffice/actions/control", field: field, value: value, action: action %>
  <% end %>
</div>
