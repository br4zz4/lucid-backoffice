<% usable = columns.select { |column| Lucid::Backoffice::Records::Query.usable?(column, revealed) } %>
<% def_filters = query.filters.select { |name, _| usable.any? { |column| column.name == name } } %>
<div class="lb-query">
  <%= form_with url: query_path, method: :post, id: "lb-sort-form" do %>
    <%= hidden_field_tag "criteria[search]", query.search, id: nil %>
    <% def_filters.each do |name, value| %><%= hidden_field_tag "criteria[filters][#{name}]", value, id: nil %><% end %>
  <% end %>
  <%= form_with url: query_path, method: :post, class: "lb-query-form" do %>
    <%= hidden_field_tag "criteria[sort]", query.sort, id: nil %>
    <%= hidden_field_tag "criteria[dir]", query.dir, id: nil %>
    <% def_filters.each do |name, value| %><%= hidden_field_tag "criteria[filters][#{name}]", value, id: nil %><% end %>
    <label class="lb-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <%= search_field_tag "criteria[search]", query.search, id: nil, placeholder: t("lucid_backoffice.search"), "aria-label": t("lucid_backoffice.search") %>
    </label>
    <%= submit_tag t("lucid_backoffice.search"), name: nil, class: "lb-button lb-button-quiet" %>
  <% end %>
  <% def_filters.each do |name, value| %>
    <%= form_with url: query_path, method: :post, class: "lb-chip" do %>
      <%= hidden_field_tag "criteria[search]", query.search, id: nil %>
      <%= hidden_field_tag "criteria[sort]", query.sort, id: nil %>
      <%= hidden_field_tag "criteria[dir]", query.dir, id: nil %>
      <% def_filters.except(name).each do |other, other_value| %><%= hidden_field_tag "criteria[filters][#{other}]", other_value, id: nil %><% end %>
      <span><%= name %> = <%= value %></span>
      <%= button_tag "✕", type: "submit", class: "lb-chip-remove", "aria-label": t("lucid_backoffice.remove_filter", name: name) %>
    <% end %>
  <% end %>
  <details class="lb-menu">
    <summary class="lb-button"><%= t("lucid_backoffice.add_filter") %></summary>
    <%= form_with url: query_path, method: :post, class: "lb-menu-list" do %>
      <%= hidden_field_tag "criteria[search]", query.search, id: nil %>
      <%= hidden_field_tag "criteria[sort]", query.sort, id: nil %>
      <%= hidden_field_tag "criteria[dir]", query.dir, id: nil %>
      <% def_filters.each do |name, value| %><%= hidden_field_tag "criteria[filters][#{name}]", value, id: nil %><% end %>
      <div class="lb-field">
        <label for="lb-filter-column"><%= t("lucid_backoffice.filter_column") %></label>
        <%= select_tag :filter_column, options_for_select(usable.map(&:name)), id: "lb-filter-column" %>
      </div>
      <div class="lb-field">
        <label for="lb-filter-value"><%= t("lucid_backoffice.filter_value") %></label>
        <%= text_field_tag :filter_value, nil, id: "lb-filter-value" %>
      </div>
      <%= submit_tag t("lucid_backoffice.apply_filter"), name: nil, class: "lb-button" %>
    <% end %>
  </details>
</div>
