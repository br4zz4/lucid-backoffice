<% actions = Lucid::Backoffice::Action.for_target(target).select { |a| allowed?(a.permission, { tenant: tenant, action: a.key }) } %>
<% if actions.any? %>
  <section class="lb-section">
    <h2><%= t("lucid_backoffice.actions") %></h2>
    <% actions.each do |a| %>
      <% reason = a.new(record: record, tenant: tenant).unavailable_reason %>
      <% path = lb_routes.new_action_path(action_key: a.key, record_id: record&.id, tenant_id: tenant && tenancy.identifier(tenant)) %>
      <% if reason %><span class="lb-button" aria-disabled="true" title="<%= reason %>"><%= a.label %></span><small><%= reason %></small>
      <% else %><a class="lb-button" href="<%= path %>"><%= a.label %></a><% end %>
    <% end %>
  </section>
<% end %>
