<% total = local_assigns[:total] %>
<% if total.to_i.positive? %>
  <% per = Lucid::Backoffice.configuration.page_size %>
  <p class="lb-pager-range"><%= t("lucid_backoffice.pager_range", from: ((page - 1) * per) + 1, to: [page * per, total].min, total: number_with_delimiter(total)) %></p>
<% end %>
<% if pages > 1 %>
  <nav class="lb-pager">
    <% (1..pages).each do |n| %>
      <% if n == page %><strong><%= n %></strong><% else %><a href="<%= url_for(request.query_parameters.merge(page: n)) %>"><%= n %></a><% end %>
    <% end %>
  </nav>
<% end %>
