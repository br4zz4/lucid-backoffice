<div class="lb-table-wrap">
  <table class="lb-table">
    <thead><tr><% columns.each do |column| %><th><%= column.name %><% unless column.category == "public" %> <small><%= column.category %></small><% end %></th><% end %></tr></thead>
    <tbody>
      <% rows.each do |cells| %>
        <tr>
          <% cells.each do |cell| %>
            <td><%= link_to_row.call(cell, cells) %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
